<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>MES.Common</id>
    <version>1.2.8</version>
    <title>MES.Common</title>
    <authors>corbin chen</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <!-- <icon>icon.png</icon> -->
    <projectUrl>http://192.168.0.111:9009/v3/index.json</projectUrl>
    <description>2023-12-14  升级SqlSugar 5.1.4.126</description>
    <releaseNotes>
      v1.0.0  基础版本
      v1.1.0  新增netmq断线重连机制
      v1.1.1  发布版
      v1.1.2-rc3 增加mqttClient获取通讯地址变量
      v1.1.2-rc4 测试打包版本日志
      v1.1.2  将SqlSugar引用dll打包
      v1.2.0-rc4 新增日志业务代码、补全Mysql.dll、新增新版授权方式
      v1.2.0  去掉System.Valuetuple
      v1.2.1  新增授权
      v1.2.3  稳定版
      v1.2.4-rc2  优化授权bug
      v1.2.4  优化授权bug;优化授权界面
      v1.2.5-rc1 打包SQLite.Interop.dll,授权加资源锁
      v1.2.5-rc2 升级SqlSugar
      v1.2.5-rc3 优化日志输出
      v1.2.5-rc4 升级SqlSugar 5.1.4.58
      v1.2.5  2023-06-19 优化mqtt连接失败时频繁写入日志，导致磁盘满的问题
      v1.2.7-rc1  2023-08-29  升级SqlSugar到5.1.4.102
      v1.2.7-rc2  2023-10-31  log加资源锁
      v1.2.8  2023-12-14  升级SqlSugar 5.1.4.126
    </releaseNotes>
    <copyright>Copyright ©2023 Macroinf Corporation</copyright>
    <tags>MES.Common</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="MQTTnet" version="3.0.8" />
        <dependency id="NetMQ" version="4.0.0.1" />
        <dependency id="SqlSugar" version="5.1.4.126" />
        <dependency id="DeviceId" version="6.0.0" />
        <dependency id="DeviceId.Windows" version="6.0.0" />
        <dependency id="DeviceId.Windows.Wmi" version="6.1.0" />
        <dependency id="MySql.Data" version="6.9.12" />
      </group>
    </dependencies>
    <contentFiles>
      <files include="DmProvider.dll" buildAction="lib" copyToOutput="true" />
      <files include="Kdbndp.dll" buildAction="lib" copyToOutput="true" />
      <files include="Newtonsoft.Json.dll" buildAction="lib" copyToOutput="true" />
      <files include="Npgsql.dll" buildAction="lib" copyToOutput="true" />
      <files include="Oracle.ManagedDataAccess.dll" buildAction="lib" copyToOutput="true" />
      <files include="System.Data.SQLite.dll" buildAction="lib" copyToOutput="true" />
      <files include="any/any/x64/SQLite.Interop.dll" buildAction="Content" copyToOutput="true" />
      <files include="any/any/x86/SQLite.Interop.dll" buildAction="Content" copyToOutput="true" />
    </contentFiles>
  </metadata>
  <files>
    <file src="README.txt" />
    <file src="DmProvider.dll" target="lib\net461\DmProvider.dll" />
    <file src="Kdbndp.dll" target="lib\net461\Kdbndp.dll" />
    <file src="Newtonsoft.Json.dll" target="lib\net461\Newtonsoft.Json.dll" />
    <file src="Npgsql.dll" target="lib\net461\Npgsql.dll" />
    <file src="Oracle.ManagedDataAccess.dll" target="lib\net461\Oracle.ManagedDataAccess.dll" />
    <file src="System.Data.SQLite.dll" target="lib\net461\System.Data.SQLite.dll" />
    <file src="x64/SQLite.Interop.dll" target="contentFiles\any\any\x64\SQLite.Interop.dll" />
    <file src="x86/SQLite.Interop.dll" target="contentFiles\any\any\x86\SQLite.Interop.dll" />
  </files>
</package>